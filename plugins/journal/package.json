{
  "name": "@godcreator/gwb-journal",
  "version": "0.3.2",
  "description": "日志：一天一个 mdx 文件，月历、待办、统计与快速记录；取代 gwb-bn-journal",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-journal.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-data": "^0.1.12",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-shell": "^0.15.11"
  },
  "devDependencies": {
    "@godcreator/utc8-time": "^0.1.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
